{
  "name": "lifeos-vue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "LifeOS — Svelte 5 + Tauri Glass shell for the database-backed personal operating system.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check && vite build",
    "preview": "vite preview",
    "icm:blueprint:ingest": "bun scripts/ingest-architecture-blueprint-icm.mjs",
    "icm:blueprint:accept-source-update": "bun scripts/ingest-architecture-blueprint-icm.mjs --accept-source-update",
    "icm:blueprint:verify": "bun scripts/ingest-architecture-blueprint-icm.mjs --verify-only",
    "figma:sidebar:check": "bun scripts/verify-figma-sidebar-companion.mjs",
    "blueprint:diagrams": "bun scripts/verify-blueprint-diagrams.mjs",
    "storage:verify": "bun scripts/verify-postgres-ruvector.mjs",
    "verify:postgres-ruvector-live": "bun scripts/verify-postgres-ruvector-live.mjs",
    "verify:lexical-retrieval-live": "bun scripts/verify-lexical-retrieval-live.mjs",
    "verify:dense-retrieval-live": "bun scripts/verify-dense-retrieval-live.mjs",
    "verify:hybrid-retrieval-live": "bun scripts/verify-hybrid-retrieval-live.mjs",
    "verify:byte-reconstruction-live": "bun scripts/verify-byte-reconstruction-live.mjs",
    "verify:open-pencil-apply-live": "bun scripts/verify-open-pencil-apply-live.mjs",
  "verify:rvf-solver-artifact": "bun scripts/verify-rvf-solver-artifact.mjs",
  "verify:ruvector-full-feature-closure": "bun scripts/verify-ruvector-full-feature-closure.mjs",
    "verify:ruvector-learning-live": "bun scripts/verify-ruvector-learning-live.mjs",
    "verify:pitr-drill": "python3 verification/pitr-drill/run_drill.py",
    "verify:ruvector-feature-matrix": "python3 verification/ruvector-feature-matrix/run_matrix.py",
    "verify:ruvector-feature-matrix:live": "RUVECTOR_DB=lifeos RUVECTOR_PGBIN=/home/flexnetos/.nix-profile/bin RUVECTOR_LIBRARY=/home/flexnetos/meta/var/lib/ruvector/ext/ruvector python3 verification/ruvector-feature-matrix/run_matrix.py",
    "verify:dirty-shutdown-recovery": "bun scripts/dirty-shutdown-recovery.mjs status",
    "verify:svelte-entrypoint": "bun scripts/verify-svelte-entrypoint.mjs",
    "verify:terminal-capability": "bun scripts/verify-terminal-capability.mjs",
    "verify:glass-ui-live": "bun scripts/verify-glass-ui-live.mjs",
    "verify:glass-launch-live": "bun scripts/verify-glass-launch-live.mjs",
    "verify:engine-room-live": "bun scripts/verify-engine-room-live.mjs",
    "verify:cow-branch-live": "bun scripts/verify-cow-branch-live.mjs",
    "verify:cow-frontdoor-live": "bun scripts/verify-cow-frontdoor-live.mjs",
    "verify:envctl-codedb-live": "bun scripts/verify-envctl-codedb-live.mjs",
    "verify:envctl-embedding-live": "bun scripts/verify-envctl-embedding-live.mjs",
    "verify:secret-lifecycle-live": "bun scripts/verify-secret-lifecycle-live.mjs",
    "verify:rtk-nu": "bun scripts/verify-rtk-nu.mjs",
    "verify:codedb-rtk-nu": "bun scripts/verify-codedb-rtk-nu.mjs",
    "verify:redb-owner-latency": "bun scripts/verify-redb-owner-latency.mjs",
    "agent:runtime": "bun scripts/lifeos-agent-runtime.mjs",
    "forecast:atas": "bun scripts/atas-forecast-lifecycle.mjs",
    "verify:nbverify004:claim001": "bun scripts/verify-nbverify004-claim001.mjs",
    "verify:nbverify004:claim002": "bun scripts/verify-nbverify004-claim002.mjs",
    "verify:nbverify004:claims003-004": "bun scripts/verify-nbverify004-claims003-004.mjs",
    "verify:nbverify004:claim005": "bun scripts/verify-nbverify004-claim005.mjs",
    "verify:nbverify004:claim006": "bun scripts/verify-nbverify004-claim006.mjs",
    "verify:nbverify004:claim007": "bun scripts/verify-nbverify004-claim007.mjs",
    "verify:nbverify004:claim008": "bun scripts/verify-nbverify004-claim008.mjs",
    "verify:nbverify004:claim009": "bun scripts/verify-nbverify004-claim009.mjs",
    "verify:nbverify004:claim010": "bun scripts/verify-nbverify004-claim010.mjs",
    "verify:nbverify004:claim011": "bun scripts/verify-nbverify004-claim011.mjs",
    "verify:nbverify004:claim012": "bun scripts/verify-nbverify004-claim012.mjs",
    "verify:nbverify004:claim013": "bun scripts/verify-nbverify004-claim013.mjs",
    "verify:nbverify004:claim014": "bun scripts/verify-nbverify004-claim014.mjs",
    "verify:nbverify004:progress": "bun scripts/verify-nbverify004-progress.mjs",
    "verify:nbverify004:claims005-007": "bun scripts/verify-nbverify004-claims005-007.mjs",
    "test:node-authority": "bunx --no-install --bun vitest run tests/node-authority-install.spec.ts",
    "verify:node-authority": "bun scripts/verify-node-authority.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icons": "bunx --no-install --bun tauri icon public/lifeos-mark.png && python3 scripts/canonicalize-icns.py src-tauri/icons/icon.icns",
    "tauri:icons:check": "python3 scripts/canonicalize-icns.py --check src-tauri/icons/icon.icns",
    "design:lint": "design.md lint DESIGN.md",
    "design:diff": "node scripts/design-diff.mjs",
    "design:export:dtcg": "design.md export --format dtcg DESIGN.md > design-system-reference/exports/tokens.json",
    "design:export:tailwind": "design.md export --format tailwind DESIGN.md > design-system-reference/exports/tailwind.theme.json",
    "design:export": "bun run design:export:dtcg && bun run design:export:tailwind",
    "test:a11y": "vitest run --config vitest.a11y.config.ts",
    "check": "svelte-check && bun run test && bun run test:a11y && bun run design:lint && bun run blueprint:diagrams && bun run tauri:icons:check && bun run verify:rtk-nu && bun run verify:codedb-rtk-nu && bun run verify:terminal-capability"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.12.0-beta.292",
    "@xterm/addon-image": "0.10.0-beta.292",
    "@xterm/addon-webgl": "0.20.0-beta.291",
    "@xterm/xterm": "6.1.0-beta.292",
    "lucide-svelte": "^1.0.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "overrides": {
    "@ruvector/rvf-solver": "file:vendor/rvf-solver"
  },
  "devDependencies": {
    "@google/design.md": "0.1.1",
    "@noble/hashes": "2.2.0",
    "@ruvector/postgres-cli": "^0.2.9",
    "@ruvector/ruvllm": "2.6.0",
    "@ruvector/rvf": "0.3.0",
    "@ruvector/rvf-solver": "file:vendor/rvf-solver",
    "@ruvector/sona": "0.1.8",
    "@ruvector/tiny-dancer": "0.1.22",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "agentdb": "3.0.0-alpha.18",
    "ajv": "^8.20.0",
    "axe-core": "^4.11.4",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^30.0.0",
    "mermaid": "^11.16.0",
    "ruflo": "3.32.9",
    "ruvector": "0.2.34",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "vitest-axe": "^0.1.0",
    "yaml": "^2.8.1"
  },
  "trustedDependencies": [
    "agentdb",
    "protobufjs"
  ]
}
